{
  lib,
  runCommand,
  secilc,
  services,
}:

# Generates the monolithic SELinux CIL policy (pure Type Enforcement, no MLS)
# from the declarative `services` graph and compiles it with secilc.
let
  inherit (lib)
    attrNames
    concatMapStringsSep
    concatStringsSep
    elem
    filter
    mapAttrsToList
    ;

  filePerms = [
    "ioctl"
    "read"
    "write"
    "create"
    "getattr"
    "setattr"
    "lock"
    "relabelfrom"
    "relabelto"
    "append"
    "map"
    "unlink"
    "link"
    "rename"
    "execute"
    "quotaon"
    "mounton"
    "audit_access"
    "open"
    "execmod"
    "watch"
    "watch_mount"
    "watch_sb"
    "watch_with_perm"
    "watch_reads"
  ];

  classes = {
    process = [
      "fork"
      "transition"
      "sigchld"
      "sigkill"
      "sigstop"
      "signull"
      "signal"
      "ptrace"
      "getsched"
      "setsched"
      "getsession"
      "getpgid"
      "setpgid"
      "getcap"
      "setcap"
      "share"
      "getattr"
      "setexec"
      "setfscreate"
      "noatsecure"
      "siginh"
      "setrlimit"
      "rlimitinh"
      "dyntransition"
      "setcurrent"
      "execmem"
      "execstack"
      "execheap"
      "setkeycreate"
      "setsockcreate"
      "getrlimit"
    ];
    process2 = [
      "nnp_transition"
      "nosuid_transition"
    ];
    file = filePerms ++ [
      "execute_no_trans"
      "entrypoint"
    ];
    dir = filePerms ++ [
      "add_name"
      "remove_name"
      "reparent"
      "search"
      "rmdir"
    ];
    lnk_file = filePerms;
    association = [
      "sendto"
      "recvfrom"
      "setcontext"
      "polmatch"
    ];
    peer = [ "recv" ];
    netif = [
      "ingress"
      "egress"
    ];
    node = [
      "recvfrom"
      "sendto"
    ];
  };

  perms = ps: "(${concatStringsSep " " ps})";

  classesCil = ''
    ${concatStringsSep "\n" (mapAttrsToList (c: ps: "(class ${c} ${perms ps})") classes)}
    (classorder ${perms (attrNames classes)})
  '';

  svcNames = attrNames services;
  domOf = name: "svc_${name}_t";
  connectToOf = name: services.${name}.connectTo or [ ];
  useSpdOf = name: services.${name}.useSpd or true;
  isServer = name: (services.${name}.listenPort or null) != null;

  serverNames = filter isServer svcNames;

  serviceRules =
    name:
    let
      d = domOf name;
      targets = connectToOf name;
    in
    ''
      ; --- service ${name} (${d}) ---
      (type ${d})
      (roletype system_r ${d})
      (typeattributeset domain (${d}))
      (typeattributeset confined_domain (${d}))

      ; Execute store binaries and read /etc, /proc, /sys.
      (allow ${d} os_file_t (file (read open getattr map ioctl lock execute execute_no_trans entrypoint)))
      (allow ${d} os_file_t (dir (read open getattr search ioctl lock)))
      (allow ${d} os_file_t (lnk_file (read getattr)))

      ; Self process operations (no setexec/setcurrent/dyntransition).
      (allow ${d} self (process (fork sigchld sigkill sigstop signull signal getsched setsched getsession getpgid setpgid getcap share getattr setrlimit getrlimit execmem)))
      (allow ${d} self (dir (read open getattr search ioctl lock)))
      (allow ${d} self (file (read write append open getattr ioctl lock)))
      (allow ${d} self (lnk_file (read getattr)))

      ; Allow SIGCHLD back to systemd / launcher.
      (allow ${d} unconfined_t (process (sigchld)))

      ${lib.optionalString (useSpdOf name) ''
        ; Match the wg0 XFRM SPD and transmit via own labeled ESP-NULL SA.
        (allow ${d} ipsec_spd_t (association (polmatch)))
        (allow ${d} self (association (sendto)))
      ''}

      ${concatMapStringsSep "\n" (target: ''
        ; Declared connectTo edge: ${name} -> ${target} (bidirectional TCP peer recv).
        (allow ${domOf target} ${d} (peer (recv)))
        (allow ${d} ${domOf target} (peer (recv)))
      '') targets}
    '';

  neverallowCil = ''
    ${concatMapStringsSep "\n" (srv: ''
      (neverallow ${domOf srv} unlabeled_t (peer (recv)))
      ${concatMapStringsSep "\n" (
        other:
        lib.optionalString (other != srv && !(elem srv (connectToOf other))) ''
          (neverallow ${domOf srv} ${domOf other} (peer (recv)))
        ''
      ) svcNames}
    '') serverNames}

    ${concatMapStringsSep "\n" (
      name:
      lib.optionalString (!(useSpdOf name)) ''
        (neverallow ${domOf name} ipsec_spd_t (association (polmatch)))
      ''
    ) svcNames}

    (neverallow confined_domain all_types (association (setcontext)))
    (neverallow confined_domain self (process (setexec setcurrent dyntransition)))
  '';

  generated = ''
    ; Generated by policy/default.nix from the declarative fleet service graph.
    ${classesCil}

    (typeattribute all_types)
    (typeattributeset all_types (all))
    ${concatMapStringsSep "\n" (c: "(allow unconfined_t all_types (${c} (all)))") (attrNames classes)}

    ; Any packet/domain may traverse netif_t and node_t; access control is
    ; enforced via association (XFRM SPD/SA) and peer (receiving socket).
    (allow all_types netif_t (netif (ingress egress)))
    (allow all_types node_t (node (recvfrom sendto)))

    ${concatMapStringsSep "\n" serviceRules svcNames}

    ${neverallowCil}
  '';
in
assert lib.assertMsg (
  lib.all (name: lib.all (t: services ? ${t}) (connectToOf name)) svcNames
) "esp-null: every connectTo target must be a declared service";
runCommand "esp-null-selinux-policy"
  {
    nativeBuildInputs = [ secilc ];
    passAsFile = [ "generated" ];
    inherit generated;
    passthru.policyVersion = 33;
  }
  ''
    mkdir -p "$out"
    cp ${./base.cil} "$out/base.cil"
    cp "$generatedPath" "$out/generated.cil"
    secilc -M false --policyvers=33 \
      --output="$out/policy.33" \
      --filecontext="$out/file_contexts" \
      "$out/base.cil" "$out/generated.cil"
  ''
